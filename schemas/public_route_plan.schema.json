{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mugenstudios.example/public/public_route_plan.schema.json",
  "title": "MUGEN Public Route Plan",
  "type": "object",
  "required": [
    "schema_status",
    "route_level",
    "route_5_triggered",
    "external_action_allowed",
    "public_claims_allowed",
    "changed_files_scope"
  ],
  "properties": {
    "schema_status": { "const": "schema_only" },
    "route_level": { "enum": ["route_0", "route_1", "route_2", "route_3", "route_4"] },
    "route_5_triggered": { "const": false },
    "external_action_allowed": { "const": false },
    "public_claims_allowed": { "const": false },
    "changed_files_scope": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
